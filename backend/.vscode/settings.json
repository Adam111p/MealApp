{
  "workbench.colorCustomizations": {
    // Pasek tytułu - klasyczny błękit Gophera
    "titleBar.activeBackground": "#00ADD8",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#0083a3",

    // Pasek boczny (Activity Bar) - ciemniejszy odcień "Cyan"
    "activityBar.background": "#0091b5",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#bbeffb",
    
    // Pasek stanu - granat nawiązujący do korporacyjnego logo Go
